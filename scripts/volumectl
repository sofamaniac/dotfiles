#!/usr/bin/env python3

import argparse
import re
import subprocess
import sys

MICROPHONE = "@DEFAULT_AUDIO_SOURCE@"
SPEAKER = "@DEFAULT_AUDIO_SINK@"


def run_wpctl(*args):
  """Execute wpctl and return its output."""
  try:
    result = subprocess.run(
        ["wpctl", *args],
        capture_output=True,
        text=True,
        check=True
    )
    return result.stdout.strip()
  except FileNotFoundError:
    print("Error: wpctl is not installed.", file=sys.stderr)
    sys.exit(1)
  except subprocess.CalledProcessError as e:
    print(f"wpctl error: {e.stderr.strip()}", file=sys.stderr)
    sys.exit(1)

def run_set_volume(target, volume, suffix=""):
  run_wpctl("set-volume", target, f"{volume}%{suffix}", "--limit", "1")


def get_volume(target):
  """Get current volume as an integer between 0 and 100."""
  output = run_wpctl("get-volume", target)

  match = re.search(r"Volume:\s*([\d.]+)", output)
  if not match:
    print("Error: Could not read volume.", file=sys.stderr)
    sys.exit(1)

  return round(float(match.group(1)) * 100)


def set_volume(target, value):
  """Set volume, rounded down to the nearest 5."""
  if not 0 <= value <= 100:
    raise ValueError("Volume must be between 0 and 100.")

  value = value - (value % 5)
  run_set_volume(target, value)


def increase_volume(target, value):
  """Increase or decrease volume."""
  if not re.fullmatch(r"[+-]?\d+", value):
    raise ValueError(f"Invalid number '{value}'.")

  amount = int(value)
  run_set_volume(target, abs(amount), "-" if amount < 0 else "+")


def toggle_mute(target):
  """Toggle mute state."""
  run_wpctl("set-mute", target, "toggle")


def main():
  parser = argparse.ArgumentParser(
      description="Control the volume of the speaker and microphone."
  )

  parser.add_argument(
      "target",
      choices=["mic", "vol"],
      help="Target: mic (microphone) or vol (speaker)"
  )

  actions = parser.add_mutually_exclusive_group()

  actions.add_argument(
      "-g", "--get",
      action="store_true",
      help="Get current volume (default)"
  )

  actions.add_argument(
      "-s", "--set",
      type=int,
      metavar="<val>",
      help="Set volume"
  )

  actions.add_argument(
      "-i", "--increase",
      metavar="[+-]<val>",
      help="Increase/decrease volume"
  )

  actions.add_argument(
      "-m", "--mute",
      action="store_true",
      help="Toggle mute"
  )

  args = parser.parse_args()

  target = MICROPHONE if args.target == "mic" else SPEAKER

  try:
    if args.mute:
        toggle_mute(target)

    elif args.set is not None:
        set_volume(target, args.set)

    elif args.increase is not None:
        increase_volume(target, args.increase)

    else:
        print(get_volume(target))

  except ValueError as e:
    print(f"Error: {e}", file=sys.stderr)
    sys.exit(1)


if __name__ == "__main__":
    main()

